# Kopieren nach .env und ausfüllen: cp .env.example .env

# Domain ohne https:// und ohne www (www leitet Caddy automatisch um).
DOMAIN=ergo-stuebe.de

# Datenbank-Passwort – nur Buchstaben und Ziffern, z. B. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Zufälliger Schlüssel für die Admin-Sitzung – `openssl rand -hex 32`.
SESSION_SECRET=

# Startpasswort für /admin, solange noch keins in der Datenbank steht.
# Nach dem ersten Login im Dashboard ändern.
ADMIN_PASSWORD=

# Resend – versendet die Formular-Mails (Absender-Domain anfrage.ergo-stuebe.de).
RESEND_API_KEY=

# Optional: nur für den KI-Textgenerator unter /admin/instagram.
OPENAI_API_KEY=
