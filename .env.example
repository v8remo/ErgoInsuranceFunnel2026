# ── Pflicht ──────────────────────────────────────────────────────────────
# Postgres-Verbindung – funktioniert mit Supabase (Pooler-URL, Port 6543),
# Neon oder der bestehenden Replit-DB-URL. Auf Vercel als Environment
# Variable setzen, lokal für `npm run dev` und `npm run db:push`.
DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require

# Resend – versendet Lead-/Schaden-/Dokumenten-Mails an morino.stuebe@ergo.de.
# Absender-Domain anfrage.ergo-stuebe.de ist im Resend-Account bereits verifiziert.
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Empfohlen ────────────────────────────────────────────────────────────
# Initialpasswort für /admin (wird beim ersten Passwortwechsel in der DB abgelöst).
ADMIN_PASSWORD=bitte-eigenes-passwort-setzen

# ── Optional ─────────────────────────────────────────────────────────────
# Nur für den KI-Textgenerator im Admin-Instagram-Tool (/admin/instagram).
OPENAI_API_KEY=
